# AgentInsight AI — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit the real .env file.

# Required: Groq API key for the SQL Agent (NL → SQL generation)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model to use for SQL generation
# Default: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Anthropic Claude key (alternative LLM provider)
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional analytics INPUT database (separate from history DATABASE_URL).
# Use a read-only account. Credentials stay on the backend.
# ANALYTICS_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/business
# ANALYTICS_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/business
# ANALYTICS_DATABASE_URL=sqlite:///C:/path/to/business.db
