# AgentInsight AI — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit the real .env file.

# Optional: Groq API key for questions beyond deterministic SQL and richer summaries
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model to use for SQL generation
# Default: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b


# Optional analytics INPUT database (separate from history DATABASE_URL).
# Use a read-only account. Credentials stay on the backend.
# ANALYTICS_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/business
# ANALYTICS_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/business
# ANALYTICS_DATABASE_URL=sqlite:///C:/path/to/business.db

# Persistent personal backend: use one HTTP server process (no --workers flag).
# INSIGHT_DATA_DIR=C:/path/to/persistent/agentinsight
# DATABASE_URL=sqlite:///C:/path/to/persistent/agentinsight/agentinsight.db
# MAX_UPLOAD_BYTES=20971520
# MAX_DATASET_ROWS=100000
# MAX_DATASET_COLUMNS=200
# MAX_EXCEL_BYTES=104857600
# JOB_QUEUE_SIZE=8
# JOB_TIMEOUT_SECONDS=300
# LLM_TIMEOUT_SECONDS=20
# SQL_TIMEOUT_SECONDS=2
# SQL_MAX_ROWS=10000
# SQL_MAX_BYTES=5242880
# SOURCE_TIMEOUT_SECONDS=15
