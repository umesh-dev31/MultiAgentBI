# AgentInsight AI — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit the real .env file.

# Required: Groq API key for the SQL Agent (NL → SQL generation)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model to use for SQL generation
# Default: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Anthropic Claude key (alternative LLM provider)
# ANTHROPIC_API_KEY=your_anthropic_key_here
